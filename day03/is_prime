# Define a function to check whether a number is prime
def is_prime(n):

    # Numbers less than or equal to 1 are not prime
    if n <= 1:
        return False

    # Check divisibility from 2 up to n-1
    for i in range(2, n):

        # If the number is divisible by i, it is not prime
        if n % i == 0:
            return False

    # If no divisor is found, the number is prime
    return True


# Test the function on numbers from 1 to 30
for num in range(1, 31):

    # Call the is_prime function and check its returned value
    if is_prime(num):
        print(f"{num} - Prime")
    else:
        print(f"{num} - Not Prime")